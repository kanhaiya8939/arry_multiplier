
//half adder code 
module half_adder(a,b,sum,carry);
input a,b;
output sum,carry;

assign sum = a^b;
assign carry = a&b;
endmodule


// fulladdercode 

module full_adder(a,b,cin,sum,cout);
input a,b,cin;
output sum,cout;

assign sum = a^b^cin;
  assign cout = (a&&b) ||(cin&&(a^b));

endmodule


